# ==========================================================
# SHOWITGLO — PRODUCTION ENVIRONMENT VARIABLES
# ==========================================================

# Base URL of your deployed application
NEXT_PUBLIC_APP_URL=https://showitglo.com
NODE_ENV=production

# ----------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# Neon, Supabase, Railway, RDS, or Self-Hosted Postgres
# ----------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/showitglo?sslmode=require

# ----------------------------------------------------------
# 2. CACHE & REALTIME (Redis)
# Upstash Redis or Self-Hosted Redis
# ----------------------------------------------------------
REDIS_URL=redis://default:token@region.upstash.io:6379

# ----------------------------------------------------------
# 3. STRIPE PAYMENTS (Apple Pay, Link & Card Top-Ups)
# ----------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ----------------------------------------------------------
JWT_SECRET=super_secret_random_64_character_hex_key_here
ADMIN_SECRET_KEY=admin_management_key_for_internal_ops

# ----------------------------------------------------------
# 5. EMAIL / OUTBID NOTIFICATIONS (Resend or Postmark)
# ----------------------------------------------------------
RESEND_API_KEY=re_...
NOTIFICATIONS_FROM_EMAIL=alerts@showitglo.com
