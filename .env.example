# ==========================================================================
# ShowItGlo — environment
#
# This file mirrors src/lib/env.ts exactly. Every variable the code reads is
# listed here and nothing else; scripts/verify-production.mjs fails the build
# if the two drift apart.
#
# Copy to .env.local for development:
#   cp .env.example .env.local
#
# In production these live in the hosting platform's environment (Vercel:
# `vercel env add <NAME> production`), never in a committed file.
# ==========================================================================


# --------------------------------------------------------------------------
# REQUIRED — validated by validateEnv() in src/lib/env.ts
#
# With STRICT_ENV_CHECK=true the server refuses to boot when any of these is
# missing or malformed. Without it, each one only logs a warning at boot and
# the affected feature degrades (payments answer 503, admin routes answer
# 503, and so on).
# --------------------------------------------------------------------------

# Postgres connection string. Use the POOLED url on Neon/serverless.
# Local: postgresql://postgres@localhost:5432/showitglo_dev
DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/showitglo?sslmode=require

# HMAC key for the anonymous session cookie (sig_uid). At least 32 characters.
# Rotating it logs every visitor out and orphans their wallet — treat it as
# permanent. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Stripe. The secret key should be a RESTRICTED key with write access to
# PaymentIntents only. The webhook secret is shown once when you create the
# endpoint in the Stripe dashboard.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe publishable key — shipped to the browser, safe to expose.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Admin/operator key for /api/v1/admin/* and the Insights API. At least 16
# characters. Admin auth FAILS CLOSED: with this unset every admin route
# answers 503, never 200. Generate with:
#   openssl rand -hex 24
ADMIN_SECRET_KEY=

# Public origin of the deployment. Must be an https:// URL in production; it
# is used for the same-origin (CSRF) check on every mutation.
NEXT_PUBLIC_APP_URL=https://showitglo.com


# --------------------------------------------------------------------------
# OPTIONAL — all have working defaults
# --------------------------------------------------------------------------

# Transactional email (Resend). Enables exactly two things and nothing else:
#   * optional email link + magic-link WALLET RECOVERY — without it a wallet
#     lives only in the visitor's browser session and is gone with the cookie;
#   * the "email for receipt" field at top-up (Stripe sends the receipt
#     itself via receipt_email; this key is not needed for that path).
# Unset is a supported state: /api/v1/me/link-email and /api/v1/auth/recover
# answer 503 EMAIL_NOT_CONFIGURED and the UI says so honestly. Nothing else
# in the product depends on it.
RESEND_API_KEY=re_...

# From address on those emails. Must be a domain verified in Resend (SPF +
# DKIM) or mail lands in spam. Default: ShowItGlo <onboarding@resend.dev>,
# which is Resend's shared sandbox sender — fine for a smoke test, not for
# production deliverability.
NOTIFICATIONS_FROM_EMAIL=ShowItGlo <noreply@showitglo.com>

# Development ONLY. When set (and NODE_ENV is not production), outgoing
# confirmation and recovery links are APPENDED TO THIS FILE instead of being
# sent, which is how the integration suite drives the link/confirm/recover
# flow end to end. The file is a list of live credentials; src/lib/env.ts
# refuses to honour this variable in production.
# EMAIL_DEBUG_FILE=/tmp/showitglo-emails.log

# Boot-time env enforcement. Set to `true` in production so a missing secret
# aborts the deploy instead of silently degrading a feature. Anything else
# (including unset) downgrades the check to warnings.
STRICT_ENV_CHECK=false

# TLS mode for the Postgres connection:
#   verify     — full certificate verification (default for remote hosts)
#   no-verify  — encrypted, certificate NOT checked (only for providers that
#                serve a self-signed cert; this is a downgrade, not a fix)
#   disable    — no TLS (default for localhost)
DATABASE_SSL=verify

# Postgres pool size PER SERVERLESS INSTANCE. The number that matters is
# instances x DB_POOL_MAX, so keep this small behind a pooled connection
# string. Default: 5 remote, 10 local.
DB_POOL_MAX=5

# Minimum distinct backers before an Insights aggregate may be published.
# Groups below this floor are SUPPRESSED from the response entirely — never
# padded, never rounded up. Default: 100.
INSIGHTS_K_MIN=100

# Log verbosity for the structured JSON logger: debug | info | warn | error.
# Default: info in production, debug otherwise.
LOG_LEVEL=info

# Set to any value to log every SQL statement with its duration. Development
# only — the output includes query text.
# DEBUG_SQL=1

# Set to 1 to allow the demo seeds (scripts/seed-dev.mjs, scripts/seed-wars.mjs)
# to run with NODE_ENV=production. They write demo content and truncate tables;
# leave this unset.
# DEMO_SEED=1

# Set by the hosting platform, not by you. Listed here because the code reads
# it: production toggles Secure cookies, TLS defaults and log level.
# NODE_ENV=production
